+#define TERMUX_USB_PREFIX "/dev/bus/usb/"
+static int linux_termux_scan_devices(struct libusb_context *ctx)
+{
+	char *end;
+	const char *value = getenv(TERMUX_USB_ENV);
+	int fd = (int)strtol(value, &end, 10);
+	uint8_t busnum, devaddr;
+	char proc_path[PATH_MAX], usbfs_path[PATH_MAX];
+	struct libusb_device *dev;
+	struct linux_device_priv *priv;
+	int r;
+
+	if (!value || *value == '\0' || *end != '\0' || fd < 0)
+		return LIBUSB_ERROR_NO_DEVICE;
+	snprintf(proc_path, sizeof(proc_path), "/proc/self/fd/%d", fd);
+	if (readlink(proc_path, usbfs_path, sizeof(usbfs_path)) < 0 ||
+		strncmp(TERMUX_USB_PREFIX, usbfs_path, strlen(TERMUX_USB_PREFIX)) != 0 ||
+		sscanf(usbfs_path, "/dev/bus/usb/%hhu/%hhu", &busnum, &devaddr) != 2)
+		return LIBUSB_ERROR_IO;
+	dev = usbi_alloc_device(ctx, ((unsigned long)busnum << 8) | devaddr);
+	if (!dev)
+		return LIBUSB_ERROR_NO_MEM;
+	r = initialize_device(dev, busnum, devaddr, NULL, fd);
+	if (r < 0) {
+		libusb_unref_device(dev);
+		return r;
+	}
+	priv = usbi_get_device_priv(dev);
+	priv->termux_fd = fd;
+	r = usbi_sanitize_device(dev);
+	if (r < 0)
+		libusb_unref_device(dev);
+	else
+		usbi_connect_device(dev);
+	return r;
+}
